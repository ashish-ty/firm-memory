# Copy to .env (which is gitignored) and fill in.
# Never hardcode credentials in tracked files — this repository is public.

OPENROUTER_API_KEY=sk-or-...
FIRM_MEM0_PG_DSN=postgresql://mem0:pw@localhost:5432/mem0

